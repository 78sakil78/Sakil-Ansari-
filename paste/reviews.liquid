</div>

<!-- ===== 2. STICKY HEADER ===== -->
<header class="header">
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <div class="nav-left">
        <button class="burger" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
        <a href="shop.html">Shop</a>
        <a href="shop.html">Pain Relief</a>
        <a href="shop.html">Beauty</a>
      </div>
      <a href="index.html" class="brand" aria-label="SKOVA home">SKOVA</a>
      <div class="nav-right">
        <a href="about.html">Our Story</a>
        <a href="contact.html">Contact</a>
        <a href="#cart" class="cart" aria-label="Cart, 0 items">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6 5 3H2"/></svg>
          <span class="count">0</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<main id="top">

<!-- ===== PAGE HERO ===== -->
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Reviews &amp; results</span>
    <h1>Loved in homes <em>across</em> India</h1>
    <p>Real comfort, honest words. Here's what customers tell us about their everyday SKOVA upgrades.</p>
  </div>
</section>

<div class="wrap" style="padding-bottom:80px">

  <!-- ===== SUMMARY CARD ===== -->
  <div class="rev-summary fade-up">
    <div class="rev-score"><div class="big">4.8</div><div class="stars" aria-hidden="true">★★★★★</div><div class="muted" style="font-size:13px">Based on 2,400+ reviews*</div></div>
